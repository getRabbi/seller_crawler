# Solo v1 zero-charge defaults. Copy to the ignored .env file; never add secrets here.
APP_ENV=local
RUNNER_MODE=development_locked
LIVE_CRAWL_ENABLED=false
PAID_SERVICES_ALLOWED=false
MAX_EXTERNAL_MONTHLY_SPEND_AUD=0
ALLOW_EXTRA_SCRAPY_UNITS=false
ALLOW_PAID_GITHUB_ACTIONS_MINUTES=false
ALLOW_PAID_ADDONS=false
PAID_ADDONS_ALLOWED=false

ZYTE_STUDENT_ENTITLEMENT_CONFIRMED=true
SCRAPY_CLOUD_DEPLOY_ENABLED=false
SCRAPY_CLOUD_MAX_UNITS=1
ZYTE_API_ENABLED=false
ZYTE_API_DAILY_REQUEST_BUDGET=0
ZYTE_API_MONTHLY_BUDGET_USD=0

GITHUB_ACTIONS_CRAWLER_ENABLED=false
GITHUB_ACTIONS_INCLUDED_MINUTES_CONFIRMED=false
CREDIT_RUNNER_ENABLED=false
CREDIT_RUNNER_MONTHLY_CAP_AUD=0
CREDIT_RUNNER_AUTO_SHUTDOWN=true

ENABLE_AMAZON=false
ENABLE_ALIBABA=false
ENABLE_1688=false
ENABLE_BUSINESS_REGISTRY=false
ENABLE_OFFICIAL_WEBSITE=true
ENABLE_SEARCH_DISCOVERY=false
ENABLE_LOCAL_PLAYWRIGHT=false
ENABLE_EMAIL_EXTRACTION=true
ENABLE_PHONE_EXTRACTION=true
ENABLE_WHATSAPP_EXTRACTION=true
ENABLE_WECHAT_EXTRACTION=true
ENABLE_AI_SUMMARY=false
ENABLE_OUTREACH=false
GLOBAL_CRAWL_KILL_SWITCH=false
OPERATOR_CRAWL_ENABLED=false

INGESTION_ENDPOINT_URL=http://127.0.0.1:8787/v1/ingest/batch
SOURCE_COOLDOWN_CHECK_URL=http://127.0.0.1:8787/v1/crawl/authorize
INGESTION_HMAC_SECRET=
INGESTION_ALLOWED_SOURCE_DOMAINS=

# Secret JSON keyring: {"key-version":"base64url-encoded-32-byte-key"}.
CONTACT_ENCRYPTION_KEYS=
CONTACT_ENCRYPTION_ACTIVE_KEY_VERSION=

SELLERINTEL_WORKSPACE_ROOT=.
LOCAL_SPOOL_DIR=.sellerintel/spool
LOCAL_RUNNER_LOCK_PATH=.sellerintel/local-runner.lock
LOCAL_RUNNER_FIXTURE_ONLY=true
LOCAL_RUNNER_DRY_RUN=true
OFFICIAL_SITE_SEED_URLS=https://acme-industrial.testmail/
OFFICIAL_SITE_FIXTURE_DIR=crawler/tests/fixtures/official_site
OFFICIAL_SITE_PAGE_BUDGET=8
OFFICIAL_SITE_MAX_DEPTH=2
OFFICIAL_SITE_DEFAULT_REGION=US
LOCAL_CRAWL_OUTPUT_PATH=.sellerintel/runs/official-site.jsonl
CRAWL_RUN_ID=

MAX_BATCH_SELLERS=25
MAX_BATCH_CONTACTS=100
MAX_BATCH_D1_STATEMENTS=20
MAX_COMPRESSED_BODY_BYTES=262144
MAX_UNCOMPRESSED_BODY_BYTES=1048576

NEXT_PUBLIC_WORKER_API_BASE_URL=http://127.0.0.1:8787
DASHBOARD_ORIGIN=http://127.0.0.1:3000
ACCESS_AUTH_REQUIRED=false
ACCESS_ALLOWED_EMAIL=
TEAM_DOMAIN=
POLICY_AUD=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=
CLOUDFLARE_WORKER_ROUTE=
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_PAGES_PROJECT=
CORE_D1_DATABASE_NAME=
CORE_D1_DATABASE_ID=
CONTACTS_D1_DATABASE_NAME=
CONTACTS_D1_DATABASE_ID=
OPS_D1_DATABASE_NAME=
OPS_D1_DATABASE_ID=
HISTORY_D1_DATABASE_NAME=
HISTORY_D1_DATABASE_ID=

# Scrapy Cloud uses this credential only; this is not a Zyte API key.
SCRAPY_CLOUD_PROJECT_ID=
SCRAPY_CLOUD_API_KEY=
SCRAPY_CLOUD_PROJECT_DIR=crawler
SCRAPY_CLOUD_ARTIFACT_VERSION=main
