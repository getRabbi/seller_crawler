{
  "name": "seller-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/dashboard",
    "apps/worker-api",
    "packages/shared-types"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p packages/shared-types/tsconfig.json --noEmit && tsc -p apps/worker-api/tsconfig.json --noEmit && tsc -p apps/dashboard/tsconfig.json --noEmit",
    "test": "vitest run",
    "health:worker": "vitest run apps/worker-api/test/health.test.ts",
    "build": "npm.cmd run build --workspace @seller-intelligence/dashboard",
    "audit:prod": "npm.cmd audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
